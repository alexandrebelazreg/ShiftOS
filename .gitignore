# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source archives (livraisons, conservées localement mais hors historique)
/docs.zip
/sprint3d-code.zip
/shiftos-current-python-port.zip

# python (spike experimental)
__pycache__/
*.py[cod]

# environnement Python isolé du solveur HiGHS : recréable depuis
# experiments/planning-v3-highs/requirements.txt, jamais versionné
/.venv-planning-highs/

# sorties du solveur HiGHS : régénérées par `solve.py` et par les tests Python,
# machine-dépendantes en temps. Les tests TypeScript qui les auditent se
# désactivent proprement quand elles sont absentes.
/experiments/planning-v3-highs/results/drive-regression-*.json
/experiments/planning-v3-highs/results/local-run-*.json
/experiments/planning-v3-highs/results/semantics-*.json
/experiments/planning-v3-highs/results/scenario-*.json
/experiments/planning-v3-highs/results/fast-*.json

# captures de problèmes réels (PLANNING_V3_DUMP_DIR). Elles portent des noms,
# des contrats et des disponibilités : elles ne quittent jamais la machine.
/tmp/
/planning-dumps/

# campagne de perturbations : les problèmes comme les résultats sont regénérés
# par `perturbations.py` depuis la seule fixture Drive canonique, qui EST
# versionnée. Les tests TypeScript qui les auditent se désactivent proprement
# quand les artefacts sont absents.
/experiments/planning-v3-highs/fixtures/perturbations/
/experiments/planning-v3-highs/results/perturbations/

# mesures du benchmark Planning V3 décomposé : régénérées à chaque exécution,
# machine-dépendantes, et déjà résumées dans docs/architecture/PLANNING_V3_DECOMPOSED.md
/planning-v3-decomposed-benchmark.json

# fichiers de travail du CLI Supabase
/supabase/.temp/
